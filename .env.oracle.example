# Copy this file to .env.oracle on the Oracle VM and fill the blanks.
# Keep .env.oracle private.

POSTGRES_PASSWORD=change-this-to-a-long-random-password
NEXT_PUBLIC_APP_URL=http://YOUR_ORACLE_PUBLIC_IP

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

GEMINI_API_KEY=
LIGHTCURVE_FLASH_JUDGE_MODEL=gemini-2.5-flash
LIGHTCURVE_PRO_JUDGE_MODEL=gemini-2.5-pro
LIGHTCURVE_EMBEDDING_MODEL=text-embedding-005

# Generate both with: openssl rand -hex 32
MOS_SERVICE_TOKEN=change-this-mos-token
SCORING_INGEST_TOKEN=change-this-scoring-token
LIGHTCURVE_CREDENTIAL_SECRET=change-this-credential-secret

# Oracle deploy stores private audio on the VM in a Docker volume.
LIGHTCURVE_AUDIO_STORAGE=local
LOCAL_STORAGE_DIR=/data/lightcurve

# Optional billing. Leave empty until Dodo is ready for this domain.
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_KEY=
DODO_ENVIRONMENT=test_mode
DODO_PRO_PRODUCT_ID=
DODO_RETURN_URL=
DODO_WEBHOOK_URL=

# Optional Google APIs. Replay TTS still needs Google Text-to-Speech credentials.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_APPLICATION_CREDENTIALS_BASE64=
GCP_REGION=us-central1
VERTEX_AI_LOCATION=us-central1
GCS_BUCKET=
KMS_KEY_NAME=

# Browser-to-SDK WebRTC.
LIGHTCURVE_STUN_URL=stun:stun.l.google.com:19302
LIGHTCURVE_TURN_URL=
LIGHTCURVE_TURN_USERNAME=
LIGHTCURVE_TURN_CREDENTIAL=

LIGHTCURVE_GATE_MIN_MOS=3.8
LIGHTCURVE_GATE_MIN_TASK=0.8

# syntax=docker/dockerfile:1

FROM node:20-bookworm-slim

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
RUN npm ci

COPY drizzle.config.ts ./
COPY src ./src
COPY scripts/migrate-voice-graph-v2.mjs ./scripts/migrate-voice-graph-v2.mjs
COPY scripts/verify-human-grounded-schema.mjs ./scripts/verify-human-grounded-schema.mjs

CMD ["npm", "run", "db:migrate"]

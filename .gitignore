# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-codex/
/.next-codex-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
next-dev.err.log
next-dev.out.log

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.oracle.example
!.env.azure.example

# vercel
.vercel
/.vercel-cli-cache/
/.vercel-cli-home/

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

# local Codex diagnostic copies
/.codex/
/.codex-gcloud-config-check/
/.gcloud-cli-home/
/.vercel-xdg-data/
/.vercel-xdg-config/
/.auth-flow/
/.azure-cli-codex/
/.docker-cli-codex/
